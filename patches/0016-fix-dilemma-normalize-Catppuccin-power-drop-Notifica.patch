 .../4x6_4_procyon/keymaps/mac/keymap.c        |  2 +-
 .../4x6_4_procyon/keymaps/mac/readme.md       | 61 ++++++++++---------
 .../keymaps/mac/rgb_matrix_user.inc           | 11 +++-
 4 files changed, 61 insertions(+), 41 deletions(-)

diff --git a/keyboards/bastardkb/dilemma/4x6_4_procyon/keymaps/mac/config.h b/keyboards/bastardkb/dilemma/4x6_4_procyon/keymaps/mac/config.h
