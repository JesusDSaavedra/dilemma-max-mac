+static two_finger_mode_t digitizer_classify_flick(two_finger_mode_t mode, uint32_t elapsed, int32_t mid_x, int32_t mid_y) {
+    if (mode != TwoFingerScroll || elapsed > DIGITIZER_FLICK_TIMEOUT) {
+        return mode;
+    }
