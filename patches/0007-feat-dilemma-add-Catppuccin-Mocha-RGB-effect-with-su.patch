 .../4x6_4_procyon/keymaps/mac/keymap.c        |   9 +-
 .../4x6_4_procyon/keymaps/mac/readme.md       |  17 +++
 .../keymaps/mac/rgb_matrix_user.inc           | 109 ++++++++++++++++++
 .../4x6_4_procyon/keymaps/mac/rules.mk        |   1 +
