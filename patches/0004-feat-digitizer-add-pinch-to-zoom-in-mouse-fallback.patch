  * even if no new digitizer data is available.
@@ -244,6 +393,10 @@ void digitizer_update_mouse_report(report_digitizer_t *report) {
                 mouse_report.y         = digitizer_scale_motion(y - last_y, &carry_y);
             } else if (contacts == 3 && duration < DIGITIZER_MOUSE_SWIPE_TIMEOUT) {
                 state = Swipe;
+#    ifdef DIGITIZER_MOUSE_PINCH_ENABLE
+            } else if (contacts == 2 && state == MoveScroll && digitizer_pinch_update(report)) {
+                // Two finger scroll or pinch, handled by digitizer_pinch_update().
+#    endif
             } else {
                 static int carry_h = 0;
                 static int carry_v = 0;
@@ -334,6 +487,12 @@ void digitizer_update_mouse_report(report_digitizer_t *report) {
         mouse_report.buttons |= 0x4;
         if (digitizer_taps_as_clicks) report->button3 = 1;
     }
+#    ifdef DIGITIZER_MOUSE_PINCH_ENABLE
+    // Any exit from a two finger gesture ends the pinch, so its modifiers can never stick.
+    if (pinch.tracking && (state != MoveScroll || contacts != 2 || !digitizer_send_mouse_reports)) {
+        digitizer_pinch_end();
+    }
+#    endif
     last_contacts = contacts;
     last_x        = x;
     last_y        = y;
