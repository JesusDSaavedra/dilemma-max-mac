+++ b/quantum/digitizer_mouse_fallback.c
@@ -71,6 +71,16 @@
 #        define DIGITIZER_MOUSE_DEFAULT_CPI 400
 #    endif
 
+// The change in distance between two fingers needed to start a pinch.
+#    ifndef DIGITIZER_PINCH_THRESHOLD
+#        define DIGITIZER_PINCH_THRESHOLD 150
+#    endif
+
+// A scaling factor that converts the change in finger distance into scroll steps while pinching.
+#    ifndef DIGITIZER_PINCH_DIVISOR
+#        define DIGITIZER_PINCH_DIVISOR 10
+#    endif
+
 #    ifdef DIGITIZER_REPORT_TAPS_AS_CLICKS
 bool digitizer_taps_as_clicks = true;
 #    else
@@ -173,6 +183,145 @@ typedef enum { None, Down, MoveScroll, Tapped, DoubleTapped, Drag, Swipe, Finish
 static State state     = None;
 static int   tap_count = 0;
 
+#    ifdef DIGITIZER_MOUSE_PINCH_ENABLE
+/**
+ * @brief Selects the modifiers held while pinching. Return 0 to send plain scroll.
+ *
+ * @return the modifier bits, MOD_BIT(KC_LEFT_GUI) by default
+ */
+__attribute__((weak)) uint8_t digitizer_pinch_mods_user(void) {
+    return MOD_BIT(KC_LEFT_GUI);
+}
+
+// Tracks a two finger gesture to tell a pinch apart from a two finger scroll.
+typedef struct {
+    bool    tracking;
+    bool    active;
+    uint8_t ids[2];
+    uint8_t mods;
+    int32_t start_distance;
+    int32_t last_distance;
+    int32_t start_x;
+    int32_t start_y;
+    int32_t last_x;
+    int32_t last_y;
+    int32_t carry_h;
+    int32_t carry_v;
+} pinch_state_t;
+
+static pinch_state_t pinch = {};
+
+static int32_t isqrt32(uint32_t n) {
+    uint32_t root = 0;
+    uint32_t bit  = 1UL << 30;
+    while (bit > n) {
+        bit >>= 2;
+    }
+    while (bit) {
+        if (n >= root + bit) {
+            n -= root + bit;
+            root = (root >> 1) + bit;
+        } else {
+            root >>= 1;
+        }
+        bit >>= 2;
+    }
+    return root;
+}
+
+static int32_t vector_length(int32_t dx, int32_t dy) {
+    return isqrt32(dx * dx + dy * dy);
+}
+
+/**
+ * @brief Ends a pinch, releasing any modifiers it holds.
+ */
+static void digitizer_pinch_end(void) {
+    if (pinch.active && pinch.mods) {
+        del_weak_mods(pinch.mods);
+        send_keyboard_report();
+    }
+    memset(&pinch, 0, sizeof(pinch));
+}
+
+/**
+ * @brief Handles a report with exactly two fingers down while moving or scrolling. The
+ * fingers scroll until the change in their distance passes DIGITIZER_PINCH_THRESHOLD
+ * and is larger than the movement of their midpoint. From then on, until the fingers
+ * lift, the selected modifiers are held and the distance change is sent as vertical
+ * scroll (spreading the fingers scrolls up, which zooms in).
+ *
+ * @param[in] report the digitizer report
+ * @return true if the report was handled
+ */
+static bool digitizer_pinch_update(const report_digitizer_t *report) {
+    // Only fingers with the tip set are touching; the report also holds fingers that just lifted.
+    int a = -1;
+    int b = -1;
+    for (int i = 0; i < DIGITIZER_FINGER_COUNT && b < 0; i++) {
+        if (report->fingers[i].tip) {
+            if (a < 0) {
+                a = i;
+            } else {
+                b = i;
+            }
+        }
+    }
+    if (b < 0) {
+        return false;
+    }
+
+    const int32_t distance = vector_length(report->fingers[a].x - report->fingers[b].x, report->fingers[a].y - report->fingers[b].y);
+    const int32_t mid_x    = (report->fingers[a].x + report->fingers[b].x) / 2;
+    const int32_t mid_y    = (report->fingers[a].y + report->fingers[b].y) / 2;
+
+    // Start again whenever the pair of fingers changes, so positions never jump.
+    if (!pinch.tracking || pinch.ids[0] != report->fingers[a].contact_id || pinch.ids[1] != report->fingers[b].contact_id) {
+        digitizer_pinch_end();
+        pinch.tracking       = true;
+        pinch.ids[0]         = report->fingers[a].contact_id;
+        pinch.ids[1]         = report->fingers[b].contact_id;
+        pinch.start_distance = distance;
+        pinch.last_distance  = distance;
+        pinch.start_x        = mid_x;
+        pinch.start_y        = mid_y;
+        pinch.last_x         = mid_x;
+        pinch.last_y         = mid_y;
+        return true;
+    }
+
+    if (!pinch.active) {
+        const int32_t change = abs(distance - pinch.start_distance);
+        if (digitizer_send_mouse_reports && change > DIGITIZER_PINCH_THRESHOLD && change > vector_length(mid_x - pinch.start_x, mid_y - pinch.start_y)) {
+            pinch.active        = true;
+            pinch.last_distance = distance;
+            pinch.carry_v       = 0;
+            pinch.mods          = digitizer_pinch_mods_user();
+            if (pinch.mods) {
+                add_weak_mods(pinch.mods);
+                send_keyboard_report();
+            }
+        } else {
+            // Scroll with the midpoint, so a pinch that has not been detected yet does not scroll.
+            const int32_t h = mid_x - pinch.last_x + pinch.carry_h;
+            const int32_t v = mid_y - pinch.last_y + pinch.carry_v;
+            pinch.carry_h   = h % DIGITIZER_SCROLL_DIVISOR;
+            pinch.carry_v   = v % DIGITIZER_SCROLL_DIVISOR;
+            mouse_report.h  = CLIP(h / DIGITIZER_SCROLL_DIVISOR, MOUSE_REPORT_HV_MIN, MOUSE_REPORT_HV_MAX);
+            mouse_report.v  = CLIP(v / DIGITIZER_SCROLL_DIVISOR, MOUSE_REPORT_HV_MIN, MOUSE_REPORT_HV_MAX);
+        }
+    } else {
+        const int32_t v     = distance - pinch.last_distance + pinch.carry_v;
+        pinch.carry_v       = v % DIGITIZER_PINCH_DIVISOR;
+        pinch.last_distance = distance;
+        mouse_report.v      = CLIP(v / DIGITIZER_PINCH_DIVISOR, MOUSE_REPORT_HV_MIN, MOUSE_REPORT_HV_MAX);
+    }
+    pinch.last_x = mid_x;
+    pinch.last_y = mid_y;
+    return true;
+}
+#    endif
+
 /**
