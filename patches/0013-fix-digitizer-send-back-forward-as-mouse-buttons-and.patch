+/**
+ * @brief Advances the gesture buttons by one mouse report.
+ *
+ * Buttons that are pressed are released, otherwise the pending buttons are pressed. A button
+ * fired while another one is still pressed waits for the release, so each one is a full click.
+ *
+ * @param[in,out] pending the buttons waiting to be pressed
+ * @param[in,out] pressed the buttons pressed in the previous report
+ * @return the buttons to press in this report
+ */
+static uint8_t digitizer_gesture_buttons_step(uint8_t *pending, uint8_t *pressed) {
+    if (*pressed) {
+        *pressed = 0;
+        return 0;
+    }
+    *pressed = *pending;
+    *pending = 0;
+    return *pressed;
+}
