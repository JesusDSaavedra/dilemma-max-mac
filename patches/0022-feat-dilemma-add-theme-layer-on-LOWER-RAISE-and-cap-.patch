+#define USER_CONFIG_MAGIC 0xD9
 
 static user_config_t user_config;
 
@@ -224,6 +267,13 @@ bool process_record_user(uint16_t keycode, keyrecord_t *record) {
         case RGB_THEME_RESTORE:
             rgb_theme_restore();
             return false;
+        case RGB_THEME_GRUVBOX:
