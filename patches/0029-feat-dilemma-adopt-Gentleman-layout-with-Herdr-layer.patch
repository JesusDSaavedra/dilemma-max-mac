+// Home-row mod tapping terms, from Gentleman's keymap.
+uint16_t get_tapping_term(uint16_t keycode, keyrecord_t *record) {
+    switch (keycode) {
+        case LGUI_T(KC_A):
+        case RGUI_T(KC_SCLN):
+            return 180;
+        case LSFT_T(KC_F):
+        case RSFT_T(KC_J):
+            return 120;
+        case LALT_T(KC_S):
+        case LCTL_T(KC_D):
+        case RCTL_T(KC_K):
+        case LALT_T(KC_L):
+            return 200;
+        default:
+            return TAPPING_TERM;
+    }
 }
 
