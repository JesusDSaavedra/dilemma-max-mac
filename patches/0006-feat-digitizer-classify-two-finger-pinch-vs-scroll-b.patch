+/**
+ * @brief Classifies a two finger gesture from the motion of each finger since it started.
+ *
+ * Fingers moving in opposite directions that also change their distance pinch. Fingers moving
+ * the same way, or with one of them (nearly) still, scroll.
+ *
+ * @param[in] ax, ay the motion of the first finger
+ * @param[in] bx, by the motion of the second finger
+ * @param[in] distance_change the change in distance between the fingers
+ * @return TwoFingerUndecided until a finger moved DIGITIZER_TWO_FINGER_DECISION_DISTANCE
+ */
+static two_finger_mode_t digitizer_classify_two_finger(int32_t ax, int32_t ay, int32_t bx, int32_t by, int32_t distance_change) {
+    const int32_t length_a = vector_length(ax, ay);
+    const int32_t length_b = vector_length(bx, by);
+    const int32_t longest  = MAX(length_a, length_b);
+    const int32_t shortest = MIN(length_a, length_b);
+
+    if (longest < DIGITIZER_TWO_FINGER_DECISION_DISTANCE) {
+        return TwoFingerUndecided;
+    }
+    if (shortest * 100 < longest * DIGITIZER_TWO_FINGER_STATIONARY_PERCENT) {
+        return TwoFingerScroll;
+    }
+    // cos(angle) = dot / (|a| * |b|), compared in percent without division.
+    const int64_t dot      = (int64_t)ax * bx + (int64_t)ay * by;
+    const bool    opposite = -dot * 100 > (int64_t)DIGITIZER_PINCH_OPPOSITE_COS_PERCENT * length_a * length_b;
+    const bool    spread   = abs(distance_change) * 100 >= DIGITIZER_PINCH_MIN_DISTANCE_CHANGE_PERCENT * (length_a + length_b);
+    return opposite && spread ? TwoFingerPinch : TwoFingerScroll;
+}
