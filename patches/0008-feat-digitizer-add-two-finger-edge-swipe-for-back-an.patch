+#        ifdef DIGITIZER_MOUSE_EDGE_SWIPE_ENABLE
+/**
+ * @brief Finds the edge zone a two finger gesture starts in.
+ *
+ * @param[in] start_x the x coordinate of the midpoint of the fingers when the gesture started
+ * @return the direction that points inwards: 1 at the left edge, -1 at the right edge, 0 elsewhere
+ */
+static int8_t digitizer_edge_swipe_side(int32_t start_x) {
+    if (start_x < DIGITIZER_EDGE_SWIPE_ZONE) {
+        return 1;
+    }
+    if (start_x > DIGITIZER_RESOLUTION_X - DIGITIZER_EDGE_SWIPE_ZONE) {
+        return -1;
+    }
+    return 0;
+}
+#        endif
+
+/**
+ * @brief Classifies a two finger gesture, including edge swipes.
+ *
+ * A gesture whose midpoint starts in an edge zone stays undecided while its midpoint moves
+ * mostly inwards, and becomes an edge swipe once it moved DIGITIZER_EDGE_SWIPE_DISTANCE inwards.
+ * A pinch, vertical travel of DIGITIZER_EDGE_SWIPE_THRESHOLD, or a direction that is not mostly
+ * inwards once the fingers moved DIGITIZER_TWO_FINGER_DECISION_DISTANCE cancels the edge swipe,
+ * and the gesture is classified by digitizer_classify_two_finger() as usual.
+ *
+ * @param[in] start_x the x coordinate of the midpoint of the fingers when the gesture started
+ * @param[in] ax, ay the motion of the first finger
+ * @param[in] bx, by the motion of the second finger
+ * @param[in] distance_change the change in distance between the fingers
+ * @return the mode of the gesture, TwoFingerUndecided while it is not known yet
+ */
+static two_finger_mode_t digitizer_classify_two_finger_gesture(int32_t start_x, int32_t ax, int32_t ay, int32_t bx, int32_t by, int32_t distance_change) {
+    const two_finger_mode_t mode = digitizer_classify_two_finger(ax, ay, bx, by, distance_change);
+#        ifdef DIGITIZER_MOUSE_EDGE_SWIPE_ENABLE
+    const int8_t side = digitizer_edge_swipe_side(start_x);
+    if (side == 0) {
+#            ifdef DIGITIZER_MOUSE_PINCH_ENABLE
+        return mode;
+#            else
+        // Without pinch support there is nothing to wait for outside the edge zones.
+        return TwoFingerScroll;
+#            endif
+    }
+    if (mode != TwoFingerPinch) {
+        const int32_t inward   = side * (ax + bx) / 2;
+        const int32_t vertical = abs(ay + by) / 2;
+        if (vertical < DIGITIZER_EDGE_SWIPE_THRESHOLD && (mode == TwoFingerUndecided || inward > vertical)) {
+            return inward >= DIGITIZER_EDGE_SWIPE_DISTANCE ? TwoFingerEdgeSwipe : TwoFingerUndecided;
+        }
+    }
+#        else
+    (void)start_x;
+#        endif
+    return mode;
 }
 
