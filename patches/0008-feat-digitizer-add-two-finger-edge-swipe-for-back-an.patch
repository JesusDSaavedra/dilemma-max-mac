 #define DIGITIZER_PINCH_DIVISOR 10                     // Higher zooms slower (trackpad units per scroll step).
 
+/*
+ * Edge swipe, like Safari on a Mac trackpad: put two fingers along the left
+ * edge and swipe right to go back (Cmd+[), or along the right edge and swipe
+ * left to go forward (Cmd+]). It fires once, then the gesture is ignored until
+ * the fingers lift. Other motion from the edge (up, down, outwards, pinch)
+ * scrolls or pinches as usual. Nothing is sent while the swipe is undecided.
+ */
+#define DIGITIZER_MOUSE_EDGE_SWIPE_ENABLE
+#define DIGITIZER_EDGE_SWIPE_ZONE (DIGITIZER_RESOLUTION_X * 15 / 100) // Midpoint of the fingers within 15% (6.3 mm) of an edge.
+#define DIGITIZER_EDGE_SWIPE_DISTANCE 900                              // Inward travel (9 mm) of the midpoint to fire.
+#define DIGITIZER_EDGE_SWIPE_THRESHOLD 400                             // Vertical travel (4 mm) that cancels the swipe.
+#define DIGITIZER_EDGE_SWIPE_BACK_KC G(KC_LBRC)                        // Cmd+[: back.
+#define DIGITIZER_EDGE_SWIPE_FORWARD_KC G(KC_RBRC)                     // Cmd+]: forward.
+
